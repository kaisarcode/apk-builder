package @PACKAGE_NAME@;

import android.Manifest;
import android.app.Activity;
import android.app.AlarmManager;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.net.Uri;
import android.os.Build;
import android.provider.Settings;

public class PermissionBridge {
    private static final int REQUEST_CODE = 64001;

    private static final class PendingRequest {
        final long requestId;
        final long generation;

        PendingRequest(long requestId, long generation) {
            this.requestId = requestId;
            this.generation = generation;
        }
    }

    private final Context context;
    private final Activity activity;
    private final AsyncBridge asyncBridge;
    private PendingRequest runtimePending;
    private PendingRequest exactAlarmPending;

    public PermissionBridge(Context context, AsyncBridge asyncBridge) {
        this.context = context;
        this.activity = context instanceof Activity ? (Activity) context : null;
        this.asyncBridge = asyncBridge;
    }

    public boolean has(String name) {
        if (isExactAlarmPermission(name)) {
            return canScheduleExactAlarms();
        }

        String permission = resolvePermission(name);
        if (permission == null) {
            return false;
        }

        if (Manifest.permission.POST_NOTIFICATIONS.equals(permission) && Build.VERSION.SDK_INT < 33) {
            return true;
        }

        return context.checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED;
    }

    public boolean request(long requestId, long generation, String name) {
        if (!asyncBridge.begin(requestId, generation)) {
            return false;
        }

        if (isExactAlarmPermission(name)) {
            requestExactAlarms(requestId, generation);
            return true;
        }

        final String permission = resolvePermission(name);
        if (permission == null) {
            asyncBridge.reject(requestId, generation, "INVALID_ARGUMENT", "Unknown permission: " + name);
            return true;
        }
        if (activity == null) {
            asyncBridge.reject(requestId, generation, "ACTIVITY_UNAVAILABLE", "Permission request requires an Activity");
            return true;
        }

        if (Manifest.permission.POST_NOTIFICATIONS.equals(permission) && Build.VERSION.SDK_INT < 33) {
            asyncBridge.resolve(requestId, generation, true);
            return true;
        }

        if (context.checkSelfPermission(permission) == PackageManager.PERMISSION_GRANTED) {
            asyncBridge.resolve(requestId, generation, true);
            return true;
        }

        synchronized (this) {
            if (runtimePending != null) {
                asyncBridge.reject(requestId, generation, "BUSY", "Another runtime permission request is active");
                return true;
            }
            runtimePending = new PendingRequest(requestId, generation);
        }

        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    activity.requestPermissions(new String[] { permission }, REQUEST_CODE);
                } catch (Exception error) {
                    PendingRequest pending;
                    synchronized (PermissionBridge.this) {
                        pending = runtimePending;
                        runtimePending = null;
                    }
                    if (pending != null) {
                        asyncBridge.reject(
                            pending.requestId,
                            pending.generation,
                            "PERMISSION_REQUEST_FAILED",
                            error.getMessage() == null ? "Permission request failed" : error.getMessage()
                        );
                    }
                }
            }
        });
        return true;
    }

    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
        if (requestCode != REQUEST_CODE) {
            return;
        }

        PendingRequest pending;
        synchronized (this) {
            pending = runtimePending;
            runtimePending = null;
        }
        if (pending == null) {
            return;
        }

        boolean granted = grantResults != null &&
            grantResults.length > 0 &&
            grantResults[0] == PackageManager.PERMISSION_GRANTED;
        asyncBridge.resolve(pending.requestId, pending.generation, granted);
    }

    public void onResume() {
        PendingRequest pending;
        synchronized (this) {
            pending = exactAlarmPending;
            exactAlarmPending = null;
        }
        if (pending != null) {
            asyncBridge.resolve(pending.requestId, pending.generation, canScheduleExactAlarms());
        }
    }

    public synchronized void destroy() {
        runtimePending = null;
        exactAlarmPending = null;
    }

    private boolean canScheduleExactAlarms() {
        if (Build.VERSION.SDK_INT < 31) {
            return true;
        }

        AlarmManager manager = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
        return manager != null && manager.canScheduleExactAlarms();
    }

    private void requestExactAlarms(long requestId, long generation) {
        if (Build.VERSION.SDK_INT < 31 || canScheduleExactAlarms()) {
            asyncBridge.resolve(requestId, generation, true);
            return;
        }
        if (activity == null) {
            asyncBridge.reject(requestId, generation, "ACTIVITY_UNAVAILABLE", "Exact alarm request requires an Activity");
            return;
        }

        synchronized (this) {
            if (exactAlarmPending != null) {
                asyncBridge.reject(requestId, generation, "BUSY", "Another exact alarm request is active");
                return;
            }
            exactAlarmPending = new PendingRequest(requestId, generation);
        }

        final Intent intent = new Intent(
            Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM,
            Uri.parse("package:" + context.getPackageName())
        );
        if (intent.resolveActivity(context.getPackageManager()) == null) {
            synchronized (this) {
                exactAlarmPending = null;
            }
            asyncBridge.reject(requestId, generation, "ACTIVITY_UNAVAILABLE", "Exact alarm settings are unavailable");
            return;
        }

        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    activity.startActivity(intent);
                } catch (Exception error) {
                    PendingRequest pending;
                    synchronized (PermissionBridge.this) {
                        pending = exactAlarmPending;
                        exactAlarmPending = null;
                    }
                    if (pending != null) {
                        asyncBridge.reject(
                            pending.requestId,
                            pending.generation,
                            "PERMISSION_REQUEST_FAILED",
                            error.getMessage() == null ? "Exact alarm request failed" : error.getMessage()
                        );
                    }
                }
            }
        });
    }

    private static boolean isExactAlarmPermission(String name) {
        return "exactAlarm".equals(name) || "exactAlarms".equals(name);
    }

    private static String resolvePermission(String name) {
        if (name == null || name.isEmpty()) {
            return null;
        }
        if (name.startsWith("android.permission.")) {
            return name;
        }

        switch (name) {
            case "notifications":
                return Manifest.permission.POST_NOTIFICATIONS;
            case "camera":
                return Manifest.permission.CAMERA;
            case "microphone":
                return Manifest.permission.RECORD_AUDIO;
            case "location":
            case "locationFine":
                return Manifest.permission.ACCESS_FINE_LOCATION;
            case "locationCoarse":
                return Manifest.permission.ACCESS_COARSE_LOCATION;
            default:
                return null;
        }
    }
}
