package @PACKAGE_NAME@;

import android.content.Context;
import android.net.ConnectivityManager;
import android.net.NetworkInfo;
import android.webkit.JavascriptInterface;
import android.widget.Toast;
import java.io.BufferedReader;
import java.io.File;
import java.io.InputStreamReader;
import java.net.URI;
import org.json.JSONArray;

public class JSBridge {
    private static final String LOCAL_ASSET_PREFIX = "file:///android_asset/";
    private static final String[] EXECUTABLE_NAMES = { @EXECUTABLE_NAMES@ };
    private final Context context;
    private final String[] trustedOrigins;
    private final PermissionBridge permissionBridge;
    private final NotificationBridge notificationBridge;
    private final AlarmBridge alarmBridge;
    private final HapticBridge hapticBridge;
    private final IntentBridge intentBridge;
    private final SystemUIBridge systemUIBridge;
    private final ClipboardBridge clipboardBridge;
    private final ScreenBridge screenBridge;
    private volatile boolean bridgeAllowed;

    public JSBridge(Context context, String[] trustedOrigins) {
        this.context = context;
        this.trustedOrigins = trustedOrigins;
        this.permissionBridge = new PermissionBridge(context);
        this.notificationBridge = new NotificationBridge(context);
        this.alarmBridge = new AlarmBridge(context);
        this.hapticBridge = new HapticBridge(context);
        this.intentBridge = new IntentBridge(context);
        this.systemUIBridge = new SystemUIBridge(context);
        this.clipboardBridge = new ClipboardBridge(context);
        this.screenBridge = new ScreenBridge(context);
    }

    public static boolean isTrustedUrl(String url, String[] trustedOrigins) {
        if (url == null || url.isEmpty()) {
            return false;
        }

        if (url.startsWith(LOCAL_ASSET_PREFIX)) {
            return true;
        }

        try {
            URI parsedUrl = URI.create(url);
            String origin = normalizeOrigin(parsedUrl);

            if (origin == null) {
                return false;
            }

            for (String trustedOrigin : trustedOrigins) {
                try {
                    URI trustedUri = URI.create(trustedOrigin);
                    String normalizedTrusted = normalizeOrigin(trustedUri);
                    if (normalizedTrusted != null && origin.equals(normalizedTrusted)) {
                        return true;
                    }
                } catch (IllegalArgumentException ignored) {
                    if (origin.equals(trustedOrigin)) {
                        return true;
                    }
                }
            }
        } catch (IllegalArgumentException ignored) {
            return false;
        }

        return false;
    }

    private static String normalizeOrigin(URI uri) {
        String scheme = uri.getScheme();
        String host = uri.getHost();

        if (scheme == null || host == null) {
            return null;
        }

        scheme = scheme.toLowerCase();
        host = host.toLowerCase();
        if (host.startsWith("www.")) {
            host = host.substring(4);
        }

        int port = uri.getPort();
        if (port == -1) {
            return scheme + "://" + host;
        }

        return scheme + "://" + host + ":" + port;
    }

    public void setCurrentUrl(String url) {
        bridgeAllowed = isTrustedUrl(url, trustedOrigins);
    }

    private boolean canUseBridge() {
        return bridgeAllowed;
    }

    private String executablePath(String name) {
        for (String executableName : EXECUTABLE_NAMES) {
            if (executableName.equals(name)) {
                String packagedName = name.replace('.', '_').replace('-', '_');
                return new File(
                    context.getApplicationInfo().nativeLibraryDir,
                    "libexec_" + packagedName + ".so"
                ).getAbsolutePath();
            }
        }
        return null;
    }

    @JavascriptInterface
    public String exec(String json) {
        if (!canUseBridge()) {
            return "";
        }
        if (json == null || json.isEmpty()) {
            return "exec: missing arguments";
        }

        try {
            JSONArray values = new JSONArray(json);
            if (values.length() == 0 || values.isNull(0)) {
                return "exec: missing executable";
            }

            String[] command = new String[values.length()];
            for (int i = 0; i < values.length(); i++) {
                if (values.isNull(i)) {
                    return "exec: invalid argument";
                }
                command[i] = values.getString(i);
            }

            String executable = executablePath(command[0]);
            if (executable == null) {
                return "exec: executable not exposed: " + command[0];
            }
            command[0] = executable;

            ProcessBuilder builder = new ProcessBuilder(command);
            builder.redirectErrorStream(true);
            Process process = builder.start();
            BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
            StringBuilder output = new StringBuilder();
            String line;

            while ((line = reader.readLine()) != null) {
                if (output.length() > 0) {
                    output.append('\n');
                }
                output.append(line);
            }

            int code = process.waitFor();
            if (code != 0 && output.length() == 0) {
                return "exec: process exited with code " + code;
            }
            return output.toString();
        } catch (Exception error) {
            return "exec: " + error.getMessage();
        }
    }

    @JavascriptInterface
    public void showToast(String message) {
        if (!canUseBridge()) {
            return;
        }

        Toast.makeText(context, message, Toast.LENGTH_SHORT).show();
    }

    @JavascriptInterface
    public boolean isOnline() {
        if (!canUseBridge()) {
            return false;
        }

        ConnectivityManager cm = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
        if (cm != null) {
            NetworkInfo netInfo = cm.getActiveNetworkInfo();
            return netInfo != null && netInfo.isConnected();
        }
        return false;
    }

    @JavascriptInterface
    public boolean permissionHas(String name) {
        return canUseBridge() && permissionBridge.has(name);
    }

    @JavascriptInterface
    public boolean permissionRequest(String name) {
        return canUseBridge() && permissionBridge.request(name);
    }

    @JavascriptInterface
    public boolean notificationCanPost() {
        return canUseBridge() && notificationBridge.canPost();
    }

    @JavascriptInterface
    public boolean notificationCreateChannel(String json) {
        return canUseBridge() && notificationBridge.createChannel(json);
    }

    @JavascriptInterface
    public boolean notificationPost(String json) {
        return canUseBridge() && notificationBridge.post(json);
    }

    @JavascriptInterface
    public boolean notificationCancel(int id) {
        return canUseBridge() && notificationBridge.cancel(id);
    }

    @JavascriptInterface
    public boolean notificationCancelAll() {
        return canUseBridge() && notificationBridge.cancelAll();
    }

    @JavascriptInterface
    public boolean alarmCanScheduleExact() {
        return canUseBridge() && alarmBridge.canScheduleExact();
    }

    @JavascriptInterface
    public boolean alarmSchedule(String json) {
        return canUseBridge() && alarmBridge.schedule(json);
    }

    @JavascriptInterface
    public boolean alarmCancel(int id) {
        return canUseBridge() && alarmBridge.cancel(id);
    }

    @JavascriptInterface
    public boolean alarmCancelAll() {
        return canUseBridge() && alarmBridge.cancelAll();
    }

    @JavascriptInterface
    public boolean hapticHasVibrator() {
        return canUseBridge() && hapticBridge.hasVibrator();
    }

    @JavascriptInterface
    public boolean hapticVibrate(long milliseconds) {
        return canUseBridge() && hapticBridge.vibrate(milliseconds);
    }

    @JavascriptInterface
    public boolean hapticEffect(String name) {
        return canUseBridge() && hapticBridge.effect(name);
    }

    @JavascriptInterface
    public boolean hapticCancel() {
        return canUseBridge() && hapticBridge.cancel();
    }

    @JavascriptInterface
    public boolean intentShare(String json) {
        return canUseBridge() && intentBridge.share(json);
    }

    @JavascriptInterface
    public boolean intentOpenUrl(String url) {
        return canUseBridge() && intentBridge.openUrl(url);
    }

    @JavascriptInterface
    public boolean intentOpenAppSettings() {
        return canUseBridge() && intentBridge.openAppSettings();
    }

    @JavascriptInterface
    public boolean systemUIStatusBar(String json) {
        return canUseBridge() && systemUIBridge.statusBar(json);
    }

    @JavascriptInterface
    public boolean systemUINavigationBar(String json) {
        return canUseBridge() && systemUIBridge.navigationBar(json);
    }

    @JavascriptInterface
    public boolean systemUIHideBars() {
        return canUseBridge() && systemUIBridge.hideBars();
    }

    @JavascriptInterface
    public boolean systemUIShowBars() {
        return canUseBridge() && systemUIBridge.showBars();
    }

    @JavascriptInterface
    public boolean clipboardSet(String text) {
        return canUseBridge() && clipboardBridge.set(text);
    }

    @JavascriptInterface
    public String clipboardGet() {
        return canUseBridge() ? clipboardBridge.get() : "";
    }

    @JavascriptInterface
    public boolean clipboardHasText() {
        return canUseBridge() && clipboardBridge.hasText();
    }

    @JavascriptInterface
    public boolean clipboardClear() {
        return canUseBridge() && clipboardBridge.clear();
    }

    @JavascriptInterface
    public boolean screenKeepOn(boolean enabled) {
        return canUseBridge() && screenBridge.keepOn(enabled);
    }
}
