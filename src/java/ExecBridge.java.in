package @PACKAGE_NAME@;

import android.content.Context;
import java.io.BufferedReader;
import java.io.File;
import java.io.InputStreamReader;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.RejectedExecutionException;
import org.json.JSONArray;
import org.json.JSONObject;

public class ExecBridge {
    private static final int MAX_WORKERS = 4;

    private static final class RunningProcess {
        final long generation;
        final Process process;

        RunningProcess(long generation, Process process) {
            this.generation = generation;
            this.process = process;
        }
    }

    private final Context context;
    private final AsyncBridge asyncBridge;
    private final String[] executableNames;
    private final ExecutorService executor = Executors.newFixedThreadPool(MAX_WORKERS);
    private final ConcurrentHashMap<String, RunningProcess> running = new ConcurrentHashMap<>();
    private volatile boolean destroyed;

    public ExecBridge(Context context, AsyncBridge asyncBridge, String[] executableNames) {
        this.context = context;
        this.asyncBridge = asyncBridge;
        this.executableNames = executableNames;
    }

    public boolean start(long requestId, long generation, String json) {
        if (!asyncBridge.begin(requestId, generation)) {
            return false;
        }

        if (destroyed) {
            asyncBridge.reject(requestId, generation, "BRIDGE_DESTROYED", "NativeBridge is shutting down");
            return true;
        }

        final String[] command;
        try {
            JSONArray values = new JSONArray(json == null ? "[]" : json);
            if (values.length() == 0 || values.isNull(0)) {
                asyncBridge.reject(requestId, generation, "INVALID_ARGUMENT", "Missing executable");
                return true;
            }

            command = new String[values.length()];
            for (int i = 0; i < values.length(); i++) {
                if (values.isNull(i)) {
                    asyncBridge.reject(requestId, generation, "INVALID_ARGUMENT", "Executable arguments cannot be null");
                    return true;
                }
                command[i] = values.getString(i);
            }

            String executable = executablePath(command[0]);
            if (executable == null) {
                asyncBridge.reject(
                    requestId,
                    generation,
                    "EXEC_NOT_EXPOSED",
                    "Executable not exposed: " + command[0]
                );
                return true;
            }
            command[0] = executable;
        } catch (Exception error) {
            asyncBridge.reject(requestId, generation, "INVALID_ARGUMENT", "Invalid exec arguments");
            return true;
        }

        try {
            executor.execute(new Runnable() {
                @Override
                public void run() {
                    runProcess(requestId, generation, command);
                }
            });
        } catch (RejectedExecutionException error) {
            asyncBridge.reject(requestId, generation, "BRIDGE_DESTROYED", "NativeBridge is shutting down");
        }

        return true;
    }

    public void cancelStale(long currentGeneration) {
        for (Map.Entry<String, RunningProcess> entry : running.entrySet()) {
            RunningProcess runningProcess = entry.getValue();
            if (runningProcess.generation != currentGeneration) {
                runningProcess.process.destroy();
                running.remove(entry.getKey(), runningProcess);
            }
        }
    }

    public void destroy() {
        destroyed = true;
        for (RunningProcess runningProcess : running.values()) {
            runningProcess.process.destroy();
        }
        running.clear();
        executor.shutdownNow();
    }

    private void runProcess(long requestId, long generation, String[] command) {
        if (destroyed || !asyncBridge.isPending(requestId, generation)) {
            return;
        }

        String processKey = key(requestId, generation);
        Process process = null;

        try {
            ProcessBuilder builder = new ProcessBuilder(command);
            builder.redirectErrorStream(true);
            process = builder.start();
            RunningProcess runningProcess = new RunningProcess(generation, process);
            running.put(processKey, runningProcess);

            if (destroyed || !asyncBridge.isPending(requestId, generation)) {
                process.destroy();
                return;
            }

            BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
            StringBuilder output = new StringBuilder();
            String line;

            while ((line = reader.readLine()) != null) {
                if (output.length() > 0) {
                    output.append('\n');
                }
                output.append(line);
            }

            int exitCode = process.waitFor();
            if (exitCode == 0) {
                asyncBridge.resolve(requestId, generation, output.toString());
                return;
            }

            JSONObject details = new JSONObject();
            details.put("exitCode", exitCode);
            details.put("output", output.toString());
            asyncBridge.reject(
                requestId,
                generation,
                "EXEC_FAILED",
                "Process exited with code " + exitCode,
                details
            );
        } catch (InterruptedException error) {
            Thread.currentThread().interrupt();
            if (process != null) {
                process.destroy();
            }
            asyncBridge.reject(requestId, generation, "CANCELLED", "Executable was cancelled");
        } catch (Exception error) {
            asyncBridge.reject(
                requestId,
                generation,
                "EXEC_FAILED",
                error.getMessage() == null ? "Executable failed" : error.getMessage()
            );
        } finally {
            running.remove(processKey);
        }
    }

    private String executablePath(String name) {
        for (String executableName : executableNames) {
            if (executableName.equals(name)) {
                String packagedName = name.replace('.', '_').replace('-', '_');
                return new File(
                    context.getApplicationInfo().nativeLibraryDir,
                    "libexec_" + packagedName + ".so"
                ).getAbsolutePath();
            }
        }
        return null;
    }

    private static String key(long requestId, long generation) {
        return generation + ":" + requestId;
    }
}
