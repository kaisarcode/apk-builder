package @PACKAGE_NAME@;

import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.webkit.WebResourceRequest;
import android.webkit.WebView;
import android.webkit.WebViewClient;

public class TrustedWebViewClient extends WebViewClient {
    private static final String NATIVE_BRIDGE_SCRIPT =
        "window.NativeBridge={"
        + "exec:function(args){return window.AndroidBridge.exec(JSON.stringify(args));},"
        + "Android:{"
        + "showToast:function(message){return window.AndroidBridge.showToast(message);},"
        + "isOnline:function(){return window.AndroidBridge.isOnline();},"
        + "permissions:{"
        + "has:function(name){return window.AndroidBridge.permissionHas(name);},"
        + "request:function(name){return window.AndroidBridge.permissionRequest(name);}},"
        + "notifications:{"
        + "canPost:function(){return window.AndroidBridge.notificationCanPost();},"
        + "createChannel:function(options){return window.AndroidBridge.notificationCreateChannel(JSON.stringify(options||{}));},"
        + "post:function(options){return window.AndroidBridge.notificationPost(JSON.stringify(options||{}));},"
        + "cancel:function(id){return window.AndroidBridge.notificationCancel(id);},"
        + "cancelAll:function(){return window.AndroidBridge.notificationCancelAll();}},"
        + "alarms:{"
        + "canScheduleExact:function(){return window.AndroidBridge.alarmCanScheduleExact();},"
        + "schedule:function(options){return window.AndroidBridge.alarmSchedule(JSON.stringify(options||{}));},"
        + "cancel:function(id){return window.AndroidBridge.alarmCancel(id);},"
        + "cancelAll:function(){return window.AndroidBridge.alarmCancelAll();}}"
        + "}};";
    private final Context context;
    private final String[] trustedOrigins;
    private final JSBridge bridge;

    public TrustedWebViewClient(Context context, String[] trustedOrigins, JSBridge bridge) {
        this.context = context;
        this.trustedOrigins = trustedOrigins;
        this.bridge = bridge;
    }

    private boolean openExternally(String url) {
        try {
            context.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
            return true;
        } catch (Exception ignored) {
            return true;
        }
    }

    private boolean handleNavigation(String url) {
        if (JSBridge.isTrustedUrl(url, trustedOrigins)) {
            return false;
        }

        return openExternally(url);
    }

    private void installBridge(WebView view, String url) {
        if (JSBridge.isTrustedUrl(url, trustedOrigins)) {
            view.evaluateJavascript(NATIVE_BRIDGE_SCRIPT, null);
        }
    }

    @Override
    public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
        if (!request.isForMainFrame()) {
            return false;
        }

        return handleNavigation(request.getUrl().toString());
    }

    @Override
    public void onPageStarted(WebView view, String url, android.graphics.Bitmap favicon) {
        bridge.setCurrentUrl(url);
        installBridge(view, url);
        super.onPageStarted(view, url, favicon);
    }

    @Override
    public void onPageFinished(WebView view, String url) {
        installBridge(view, url);
        super.onPageFinished(view, url);
    }
}
