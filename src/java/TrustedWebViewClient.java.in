package @PACKAGE_NAME@;

import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.webkit.WebResourceRequest;
import android.webkit.WebView;
import android.webkit.WebViewClient;
import java.io.BufferedReader;
import java.io.InputStream;
import java.io.InputStreamReader;

public class TrustedWebViewClient extends WebViewClient {
    private static final String NATIVE_BRIDGE_RESOURCE = "native_bridge";
    private final Context context;
    private final String[] trustedOrigins;
    private final JSBridge bridge;
    private final String nativeBridgeScript;

    public TrustedWebViewClient(Context context, String[] trustedOrigins, JSBridge bridge) {
        this.context = context;
        this.trustedOrigins = trustedOrigins;
        this.bridge = bridge;
        this.nativeBridgeScript = loadBridgeScript(context);
    }

    private boolean openExternally(String url) {
        try {
            context.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)));
            return true;
        } catch (Exception ignored) {
            return true;
        }
    }

    private boolean handleNavigation(String url) {
        if (JSBridge.isTrustedUrl(url, trustedOrigins)) {
            return false;
        }

        return openExternally(url);
    }

    private void installBridge(WebView view, String url, long generation) {
        if (!JSBridge.isTrustedUrl(url, trustedOrigins) || nativeBridgeScript.isEmpty()) {
            return;
        }

        String script = nativeBridgeScript +
            "\n;if(window.NativeBridge&&window.NativeBridge.__kcapk){" +
            "window.NativeBridge.__setGeneration(" + generation + ");}";
        view.evaluateJavascript(script, null);
    }

    @Override
    public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
        if (!request.isForMainFrame()) {
            return false;
        }

        return handleNavigation(request.getUrl().toString());
    }

    @Override
    public void onPageStarted(WebView view, String url, android.graphics.Bitmap favicon) {
        long generation = bridge.beginPage(url);
        installBridge(view, url, generation);
        super.onPageStarted(view, url, favicon);
    }

    @Override
    public void onPageFinished(WebView view, String url) {
        installBridge(view, url, bridge.getPageGeneration());
        super.onPageFinished(view, url);
    }

    private static String loadBridgeScript(Context context) {
        int resourceId = context.getResources().getIdentifier(
            NATIVE_BRIDGE_RESOURCE,
            "raw",
            context.getPackageName()
        );
        if (resourceId == 0) {
            return "";
        }

        StringBuilder script = new StringBuilder();
        try (
            InputStream input = context.getResources().openRawResource(resourceId);
            BufferedReader reader = new BufferedReader(new InputStreamReader(input))
        ) {
            String line;
            while ((line = reader.readLine()) != null) {
                script.append(line).append('\n');
            }
            return script.toString();
        } catch (Exception ignored) {
            return "";
        }
    }
}
