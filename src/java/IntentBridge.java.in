package @PACKAGE_NAME@;

import android.app.Activity;
import android.content.ClipData;
import android.content.ContentResolver;
import android.content.Context;
import android.content.Intent;
import android.database.Cursor;
import android.net.Uri;
import android.os.Build;
import android.provider.OpenableColumns;
import android.provider.Settings;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.Set;
import org.json.JSONArray;
import org.json.JSONObject;

public class IntentBridge {
    private final Context context;
    private JSONObject pendingShare;

    public IntentBridge(Context context) {
        this.context = context;
    }

    public boolean share(String json) {
        try {
            JSONObject options = new JSONObject(json);
            Intent sendIntent = new Intent(Intent.ACTION_SEND);
            sendIntent.setType(options.optString("type", "text/plain"));

            if (options.has("text")) {
                sendIntent.putExtra(Intent.EXTRA_TEXT, options.optString("text", ""));
            }
            if (options.has("subject")) {
                sendIntent.putExtra(Intent.EXTRA_SUBJECT, options.optString("subject", ""));
            }
            if (options.has("title")) {
                sendIntent.putExtra(Intent.EXTRA_TITLE, options.optString("title", ""));
            }

            String chooserTitle = options.optString("chooserTitle", "");
            Intent chooser = Intent.createChooser(
                sendIntent,
                chooserTitle.isEmpty() ? null : chooserTitle
            );
            return start(chooser);
        } catch (Exception ignored) {
            return false;
        }
    }

    public boolean openUrl(String url) {
        if (url == null || url.isEmpty()) {
            return false;
        }

        Uri uri;
        try {
            uri = Uri.parse(url);
        } catch (Exception ignored) {
            return false;
        }

        String scheme = uri.getScheme();
        if (!"http".equalsIgnoreCase(scheme) && !"https".equalsIgnoreCase(scheme)) {
            return false;
        }

        return start(new Intent(Intent.ACTION_VIEW, uri));
    }

    public boolean openAppSettings() {
        Intent intent = new Intent(
            Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
            Uri.parse("package:" + context.getPackageName())
        );
        return start(intent);
    }

    public synchronized void receive(Intent intent) {
        if (intent == null) {
            return;
        }

        String action = intent.getAction();
        if (!Intent.ACTION_SEND.equals(action) && !Intent.ACTION_SEND_MULTIPLE.equals(action)) {
            return;
        }

        try {
            JSONObject share = new JSONObject();
            share.put("action", Intent.ACTION_SEND_MULTIPLE.equals(action) ? "sendMultiple" : "send");
            share.put("type", intent.getType() == null ? "" : intent.getType());

            CharSequence text = intent.getCharSequenceExtra(Intent.EXTRA_TEXT);
            if (text != null) {
                share.put("text", text.toString());
            }

            String subject = intent.getStringExtra(Intent.EXTRA_SUBJECT);
            if (subject != null) {
                share.put("subject", subject);
            }

            JSONArray files = new JSONArray();
            Set<String> seenUris = new HashSet<String>();
            collectStreamExtras(intent, files, seenUris);
            collectClipData(intent.getClipData(), files, seenUris);
            share.put("files", files);

            pendingShare = share;
        } catch (Exception ignored) {
            pendingShare = null;
        }
    }

    public synchronized String consumeShare() {
        if (pendingShare == null) {
            return "";
        }

        String json = pendingShare.toString();
        pendingShare = null;
        return json;
    }

    private void collectStreamExtras(Intent intent, JSONArray files, Set<String> seenUris) {
        if (Intent.ACTION_SEND_MULTIPLE.equals(intent.getAction())) {
            ArrayList<Uri> streams;
            if (Build.VERSION.SDK_INT >= 33) {
                streams = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM, Uri.class);
            } else {
                streams = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM);
            }

            if (streams != null) {
                for (Uri uri : streams) {
                    addUri(files, seenUris, uri);
                }
            }
            return;
        }

        Uri stream;
        if (Build.VERSION.SDK_INT >= 33) {
            stream = intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri.class);
        } else {
            stream = intent.getParcelableExtra(Intent.EXTRA_STREAM);
        }
        addUri(files, seenUris, stream);
    }

    private void collectClipData(ClipData clipData, JSONArray files, Set<String> seenUris) {
        if (clipData == null) {
            return;
        }

        for (int i = 0; i < clipData.getItemCount(); i++) {
            addUri(files, seenUris, clipData.getItemAt(i).getUri());
        }
    }

    private void addUri(JSONArray files, Set<String> seenUris, Uri uri) {
        if (uri == null) {
            return;
        }

        String uriString = uri.toString();
        if (!seenUris.add(uriString)) {
            return;
        }

        try {
            JSONObject file = new JSONObject();
            file.put("uri", uriString);

            ContentResolver resolver = context.getContentResolver();
            String mimeType = resolver.getType(uri);
            file.put("type", mimeType == null ? "" : mimeType);

            Cursor cursor = null;
            try {
                cursor = resolver.query(
                    uri,
                    new String[] { OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE },
                    null,
                    null,
                    null
                );
                if (cursor != null && cursor.moveToFirst()) {
                    int nameIndex = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
                    int sizeIndex = cursor.getColumnIndex(OpenableColumns.SIZE);
                    if (nameIndex >= 0 && !cursor.isNull(nameIndex)) {
                        file.put("name", cursor.getString(nameIndex));
                    }
                    if (sizeIndex >= 0 && !cursor.isNull(sizeIndex)) {
                        file.put("size", cursor.getLong(sizeIndex));
                    }
                }
            } finally {
                if (cursor != null) {
                    cursor.close();
                }
            }

            files.put(file);
        } catch (Exception ignored) {
        }
    }

    private boolean start(Intent intent) {
        try {
            if (!(context instanceof Activity)) {
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            }
            context.startActivity(intent);
            return true;
        } catch (Exception ignored) {
            return false;
        }
    }
}
